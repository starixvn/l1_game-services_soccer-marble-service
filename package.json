{
    "name": "marble-football-service",
    "version": "1.0.0",
    "description": "",
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/game-services/marble-football-service.git"
    },
    "author": "",
    "license": "ISC",
    "main": "./build/app.js",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "jest --testPathPatterns=tests/unit-tests/ ",
        "test-coverage": "jest --coverage --testPathPatterns=tests/unit-tests/",
        "integration-test": "npm run build && jest --config ./jest.integration-test.config.cjs --testPathPatterns=tests/integration-tests/ --forceExit",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/app.ts",
        "dev-build": "nodemon --experimental-loader=extensionless --watch ./build ./build/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "fetch-video-timelines": "tsx src/timelines/fetch-default-video-timeline.ts",
        "test-voice": "tsx src/timelines/test-voice.ts"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "awilix": "^12.0.5",
        "axios": "^1.8.2",
        "cacheable": "^1.9.0",
        "chance": "^1.1.11",
        "extensionless": "^1.9.6",
        "https-proxy-agent": "^7.0.6",
        "jest-mock-extended": "^4.0.0",
        "mongoose": "^6.13.8",
        "odds-feed-client": "3.4.2",
        "sc-common": "^3.0.0",
        "sc-game-base": "6.3.2",
        "sc-game-management-client": "^0.1.0",
        "socket.io": "^4.5.4"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.23.9",
        "@commitlint/cli": "^18.6.0",
        "@commitlint/config-conventional": "^18.6.0",
        "@types/chance": "^1.1.6",
        "@types/d3-array": "^3.2.1",
        "@types/jest": "30.0.0",
        "@types/lodash.shuffle": "^4.2.9",
        "@types/sc-common": "1.0.2",
        "@types/sc-game-base": "^2.0.0",
        "@types/sc-game-service-integration-utils": "1.0.0",
        "cross-env": "^7.0.3",
        "husky": "^9.0.6",
        "jest": "30.1.3",
        "jest-junit": "16.0.0",
        "jest-sonar-reporter": "2.0.0",
        "nodemon": "^3.0.3",
        "sc-game-service-integration-utils": "2.3.3-beta3",
        "ts-jest": "29.4.0",
        "tsx": "4.20.3",
        "typescript": "5.9.2"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
